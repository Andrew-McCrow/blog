# Copy this file to .env and fill in the values
# cp .env.example .env

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=blogdb

# API
JWT_SECRET=change_me

# Frontend build-time URLs (must point to where the API is reachable from the browser)
VITE_API_URL=http://localhost:3000
VITE_POSTS_URL=http://localhost:3000/api/posts
VITE_COMMENTS_URL=http://localhost:3000/api/comments
